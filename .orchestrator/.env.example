# =============================================================================
# Orchestrator Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All values shown are the defaults.

# =============================================================================
# Database Configuration (PostgreSQL - Recommended for Production)
# =============================================================================

# Portal Database (async SQLAlchemy with asyncpg)
# For PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:Pg12345!@localhost:5432/orchestrator
# For SQLite (development only):
# DATABASE_URL=postgresql+asyncpg://postgres:Pg12345!@localhost:5432/orchestrator

# Core Database (sync SQLAlchemy with psycopg2)
# These environment variables are used by the core db subsystem
ORCH_DB_HOST=localhost
ORCH_DB_PORT=5432
ORCH_DB_NAME=orchestrator
ORCH_DB_USER=postgres
ORCH_DB_PASSWORD=Pg12345!
ORCH_DB_POOL_MIN=1
ORCH_DB_POOL_MAX=10

# Enable SQL query logging (for debugging)
SQL_ECHO=false

# Database connection pool size (for portal async engine)
DB_POOL_SIZE=5

# Connection recycle time in seconds (for portal async engine)
DB_POOL_RECYCLE=3600

# =============================================================================
# Worker Pool Configuration
# =============================================================================

# Maximum number of concurrent job workers
# Rule of thumb: Set to CPU cores for CPU-bound tasks, 2x cores for I/O-bound
MAX_WORKERS=4

# Maximum jobs that can be queued waiting for a worker
MAX_QUEUE_SIZE=100

# Default timeout for jobs (seconds) - can be overridden per-job
DEFAULT_JOB_TIMEOUT=3600

# Graceful shutdown timeout (seconds) - how long to wait for jobs to finish
GRACEFUL_TIMEOUT=30.0

# =============================================================================
# CLI Execution Configuration
# =============================================================================

# Command to execute for CLI jobs
CLI_COMMAND=uv run cli.py

# Project root directory (for resolving relative paths)
PROJECT_ROOT=.

# Working directory for CLI execution (optional)
# CLI_WORKING_DIR=

# =============================================================================
# Server Configuration
# =============================================================================

# Server bind address
HOST=0.0.0.0

# Server port
PORT=8000

# Enable auto-reload (for development only)
RELOAD=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# =============================================================================
# SSE Streaming Configuration
# =============================================================================

# Maximum SSE connections per job
MAX_SSE_CONNECTIONS=100

# SSE heartbeat interval (seconds)
SSE_HEARTBEAT=30

# Event buffer size per job (for replay on reconnection)
EVENT_BUFFER_SIZE=1000

# Event batch size before flush to database
EVENT_BATCH_SIZE=10

# Event flush interval (seconds)
EVENT_FLUSH_INTERVAL=1.0
